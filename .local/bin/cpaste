#!/usr/bin/env python3
"""
cpaste - Terminal Clipboard Sanitizer for Wayland
Cleans up broken line wraps, trailing whitespace, and carriage returns from text copied in the terminal.
"""
import subprocess
import sys
import re

def get_clipboard():
    try:
        res = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, check=True)
        return res.stdout
    except Exception as e:
        print("❌ Error reading clipboard:", e, file=sys.stderr)
        sys.exit(1)

def set_clipboard(text):
    try:
        process = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE, text=True)
        process.communicate(input=text)
    except Exception as e:
        print("❌ Error setting clipboard:", e, file=sys.stderr)
        sys.exit(1)

def sanitize(text):
    # Remove carriage returns (\r)
    text = text.replace('\r', '')
    # Strip trailing whitespace on each line
    lines = [line.rstrip() for line in text.split('\n')]
    
    cleaned_lines = []
    i = 0
    while i < len(lines):
        line = lines[i]
        # If line is empty or starts with special formatting/bullets/URLs/protocols, keep as new line
        if not line or re.match(r'^(udp://|http://|https://|magnet:|#|\*|-|\d+\.|\>|\$|--|==)', line):
            cleaned_lines.append(line)
        else:
            # Check if previous line wasn't empty and shouldn't be separated
            if cleaned_lines and cleaned_lines[-1] and not re.match(r'^(udp://|http://|https://|magnet:|#|\*|-|\d+\.|\>|\$|--|==)', cleaned_lines[-1]):
                # Merge with previous line if it was an artificial terminal line wrap
                cleaned_lines[-1] += " " + line.lstrip()
            else:
                cleaned_lines.append(line)
        i += 1
        
    return '\n'.join(cleaned_lines).strip() + '\n'

if __name__ == "__main__":
    raw = get_clipboard()
    if not raw.strip():
        print("⚠️ Clipboard is empty!")
        sys.exit(0)
        
    clean = sanitize(raw)
    set_clipboard(clean)
    print("✔ Clipboard sanitized! Broken terminal line-wraps and formatting cleaned.")
